{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kylin-memory-bench:dataset:v1",
  "title": "Kylin Memory Bench dataset v1",
  "type": "object",
  "required": ["schema", "dataset_id", "seed", "provenance", "cases"],
  "properties": {
    "schema": {"const": "kmb.dataset/v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "provenance": {"type": "object"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "fact": {
      "type": "object",
      "required": ["subject", "key", "value", "policy", "revision"],
      "properties": {
        "subject": {"type": "string"}, "key": {"type": "string"}, "value": {},
        "policy": {"enum": ["retain", "session_only", "sensitive", "risk", "noise"]},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "phase": {
      "type": "object", "required": ["id", "kind", "session", "message"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"},
        "kind": {"enum": ["write", "distract", "update", "query", "action"]},
        "session": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "assertion": {
      "type": "object", "required": ["id", "phase", "type"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "phase": {"type": "string"},
        "type": {"enum": ["response_value", "response_absent", "memory_absent", "artifact_json"]},
        "field": {"const": "answer"}, "expected": {},
        "alternatives": {"type": "array"},
        "forbidden": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "path": {"type": "string", "minLength": 1}, "require_abstention": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"enum": ["response_value", "artifact_json"]}}}, "then": {"required": ["expected"]}},
        {"if": {"properties": {"type": {"const": "artifact_json"}}}, "then": {"required": ["path"]}},
        {"if": {"properties": {"type": {"enum": ["response_absent", "memory_absent"]}}}, "then": {"required": ["forbidden"]}}
      ]
    },
    "case": {
      "type": "object", "required": ["id", "dimension", "stratum", "synthetic", "facts", "phases", "assertions"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"},
        "dimension": {"enum": ["persistence", "retrieval", "update", "discrimination", "boundary", "reuse"]},
        "stratum": {"type": "string"}, "synthetic": {"const": true},
        "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "phases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/phase"}},
        "assertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assertion"}}
      }
    }
  }
}
